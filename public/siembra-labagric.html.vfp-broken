    [{label:'Costo',data:byLabor.map(x=>x[1]),backgroundColor:COLORS,borderRadius:6}],
    {indexAxis:true,moneyTooltip:true,noLegend:true,full:true,tall:true});
  
  // 2. Costo por Lote (bar)
  const byLote=groupBy(d,'lote','costoTotal');
  makeChart('chartsAplic','chAplicLote','📍 Inversión por Lote','Costo de aplicaciones por lote','bar',
