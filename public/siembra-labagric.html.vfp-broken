    [{data:byEtapa.map(x=>x[1]),backgroundColor:COLORS}],
    {moneyTooltipPie:true});
  
  // 4. Top Productos por Costo (bar)
  const topProd=getTopN(d,'producto','costoTotal',12);
  makeChart('chartsAplic','chAplicTopProd','🏆 Top 12 Productos Más Costosos','Productos con mayor inversión','bar',
    topProd.map(x=>x[0].length>20?x[0].substring(0,20)+'…':x[0]),
    [{label:'Costo',data:topProd.map(x=>x[1]),backgroundColor:COLORS,borderRadius:6}],
    {indexAxis:true,moneyTooltip:true,noLegend:true,full:true,tall:true});
  
  // 5. Cantidad de Aplicaciones por Labor
