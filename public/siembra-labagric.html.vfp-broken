  makeChart('chartsAplic','chAplicLaborCount','📋 Frecuencia de Labores','Cantidad de aplicaciones por tipo','bar',
    laborCount.map(x=>x[0].length>25?x[0].substring(0,25)+'…':x[0]),
    [{label:'Aplicaciones',data:laborCount.map(x=>x[1]),backgroundColor:'rgba(139,92,246,.7)',borderRadius:6}],
    {noLegend:true,full:true});
  
  // 6. Productos por Etapa (stacked bar)
  const etapas=[...new Set(d.map(r=>r.etapa))].filter(Boolean).sort();
  const topProds5=getTopN(d,'producto','costoTotal',5).map(x=>x[0]);
  const stackedDS=topProds5.map((prod,i)=>({
    label:prod.length>20?prod.substring(0,20)+'…':prod,
    data:etapas.map(e=>d.filter(r=>r.etapa===e&&r.producto===prod).reduce((s,r)=>s+r.costoTotal,0)),
    backgroundColor:COLORS[i],borderRadius:4
  }));
  makeChart('chartsAplic','chAplicStacked','📊 Top 5 Productos por Etapa','Distribución de costos','bar',
    etapas,stackedDS,{stacked:true,moneyTooltip:true,full:true});
}

// ═══════════════════════════════════════════════
// CONSOLIDADO CHARTS
// ═══════════════════════════════════════════════
function renderChartsConsolidado(){
  const el=document.getElementById('chartsConsolidado');el.innerHTML='';
  const ds=getFilteredSiembra(),da=getFilteredAplic();
  const costoS=ds.reduce((s,r)=>s+r.costo,0);
  const costoA=da.reduce((s,r)=>s+r.costoTotal,0);
  
  // 1. Distribución General (doughnut)
  makeChart('chartsConsolidado','chConsDist','🏦 Distribución de Inversión','Siembra vs Aplicaciones','doughnut',
    ['Costo de Siembra','Costo de Aplicaciones'],
    [{data:[costoS,costoA],backgroundColor:['#10b981','#ef4444']}],
    {moneyTooltipPie:true});
  
  // 2. Costo Total por Lote (stacked bar)
  const lotesAll=[...new Set([...ds.map(r=>r.lote),...da.map(r=>r.lote)])].filter(Boolean).sort();
  const siembraByLote={};ds.forEach(r=>{siembraByLote[r.lote]=(siembraByLote[r.lote]||0)+r.costo});
  const aplicByLote={};da.forEach(r=>{aplicByLote[r.lote]=(aplicByLote[r.lote]||0)+r.costoTotal});
  makeChart('chartsConsolidado','chConsLote','📍 Inversión Total por Lote','Siembra + Aplicaciones combinadas','bar',
    lotesAll.map(l=>'Lote '+l),
    [{label:'Siembra',data:lotesAll.map(l=>siembraByLote[l]||0),backgroundColor:'rgba(16,185,129,.8)',borderRadius:4},
     {label:'Aplicaciones',data:lotesAll.map(l=>aplicByLote[l]||0),backgroundColor:'rgba(239,68,68,.8)',borderRadius:4}],
    {stacked:true,moneyTooltip:true});
  
  // 3. Costo por Semana (siembra line)
  const semAll=[...new Set(ds.map(r=>String(r.sem)))].sort((a,b)=>+a-+b);
  const semCosto={};ds.forEach(r=>{const k=String(r.sem);semCosto[k]=(semCosto[k]||0)+r.costo});
  makeChart('chartsConsolidado','chConsSemana','📅 Evolución Semanal de Siembra','Tendencia de inversión','line',
    semAll.map(s=>'Sem '+s),
    [{label:'Costo Siembra',data:semAll.map(s=>semCosto[s]||0),borderColor:'#10b981',backgroundColor:'rgba(16,185,129,.1)',fill:true,tension:.4,pointRadius:2}],
    {moneyTooltip:true,full:true});
  
  // 4. Costo por Hectárea por Lote (bar)
  const areaByLote={};ds.forEach(r=>{areaByLote[r.lote]=(areaByLote[r.lote]||0)+r.area});
  const costoPorHaByLote=lotesAll.map(l=>{
    const costoTotal=(siembraByLote[l]||0)+(aplicByLote[l]||0);
    const areaLote=areaByLote[l]||0;
    return {lote:l,costoHa:areaLote>0?costoTotal/areaLote:0,area:areaLote,costoTotal};
  }).filter(x=>x.area>0).sort((a,b)=>b.costoHa-a.costoHa);
  makeChart('chartsConsolidado','chConsCostoHa','🌿 Costo Total por Hectárea','(Siembra + Aplicaciones) / Área sembrada','bar',
    costoPorHaByLote.map(x=>'Lote '+x.lote),
    [{label:'Costo/Ha',data:costoPorHaByLote.map(x=>x.costoHa),backgroundColor:costoPorHaByLote.map((_,i)=>COLORS[i%COLORS.length]),borderRadius:6}],
    {moneyTooltip:true,noLegend:true,full:true});

  // 5. Costo Integral por Lote (bar)
  const integralByLote=lotesAll.map(l=>({lote:l,siembra:siembraByLote[l]||0,aplic:aplicByLote[l]||0,total:(siembraByLote[l]||0)+(aplicByLote[l]||0)}));
  integralByLote.sort((a,b)=>b.total-a.total);
  makeChart('chartsConsolidado','chConsIntegral','🏆 Ranking de Lotes por Inversión Total','De mayor a menor costo integral','bar',
    integralByLote.map(x=>'Lote '+x.lote),
    [{label:'Total',data:integralByLote.map(x=>x.total),backgroundColor:COLORS.slice(0,integralByLote.length),borderRadius:6}],
    {moneyTooltip:true,noLegend:true,full:true});
  
  // 6. Top 10 Labores más costosas
  const topLabores=getTopN(da,'labor','costoTotal',10);
  makeChart('chartsConsolidado','chConsLabores','🔧 Top 10 Labores de Aplicación','Labores con mayor inversión','bar',
    topLabores.map(x=>x[0].length>28?x[0].substring(0,28)+'…':x[0]),
    [{label:'Costo',data:topLabores.map(x=>x[1]),backgroundColor:COLORS,borderRadius:6}],
    {indexAxis:true,moneyTooltip:true,noLegend:true,full:true,tall:true});
}

// ═══════════════════════════════════════════════
// TABLE BUILDER
// ═══════════════════════════════════════════════
function renderTableSiembra(){
  const d=getFilteredSiembra();
  const container=document.getElementById('tableSiembra');
  container.innerHTML='';
  buildTable(container,'tblSiembra','📋 Detalle de Siembra',
    ['Sem','Fecha','Lote','Bloque','Terraza','Área','Plantas','Precio','Costo','Material','Tipo','Procedencia'],
    d.map(r=>[r.sem,r.fecha,'Lote '+r.lote,r.bloque,r.terraza,r.area.toFixed(3),{v:r.plantas,cls:'num'},{v:'₡'+r.precio.toFixed(2),cls:'num money'},{v:'₡'+fmt(r.costo),cls:'num money'},r.material,r.tipoNorm,r.proced]),
    d.length);
}
function renderTableAplic(){
  const d=getFilteredAplic();
  const container=document.getElementById('tableAplic');
  container.innerHTML='';
  buildTable(container,'tblAplic','📋 Detalle de Aplicaciones',
    ['Lote','Grupo','Fecha','Etapa','Labor','Producto','Unidad','Cantidad','Precio Unit.','Costo Total'],
    d.map(r=>['Lote '+r.lote,r.grupo,r.fechaAplic,r.etapa,r.labor.length>30?r.labor.substring(0,30)+'…':r.labor,r.producto,r.unidad,{v:r.cantidad.toFixed(2),cls:'num'},{v:'₡'+fmt(r.precioUnit),cls:'num money'},{v:'₡'+fmt(r.costoTotal),cls:'num money'}]),
    d.length);
}
function renderTableConsolidado(){
  const ds=getFilteredSiembra(),da=getFilteredAplic();
  const container=document.getElementById('tableConsolidado');
  container.innerHTML='';
  const lotesAll=[...new Set([...ds.map(r=>r.lote),...da.map(r=>r.lote)])].filter(Boolean).sort();
  const rows=lotesAll.map(l=>{
    const sRows=ds.filter(r=>r.lote===l);
    const aRows=da.filter(r=>r.lote===l);
    const sCosto=sRows.reduce((s,r)=>s+r.costo,0);
    const aCosto=aRows.reduce((s,r)=>s+r.costoTotal,0);
    const plantas=sRows.reduce((s,r)=>s+r.plantas,0);
    const area=sRows.reduce((s,r)=>s+r.area,0);
    const densidadProm=sRows.length?sRows.reduce((s,r)=>s+r.densidad,0)/sRows.length:0;
    const total=sCosto+aCosto;
    const costoPP=plantas?total/plantas:0;
    const costoHa=area>0?total/area:0;
    return ['Lote '+l,{v:fmtInt(plantas),cls:'num'},{v:area.toFixed(2),cls:'num'},{v:fmtInt(densidadProm),cls:'num'},{v:fmtMoney(sCosto),cls:'num money'},{v:fmtMoney(aCosto),cls:'num money'},{v:fmtMoney(total),cls:'num money'},{v:fmtMoney(costoHa),cls:'num money'},{v:'₡'+costoPP.toFixed(2),cls:'num money'},{v:aRows.length,cls:'num'}];
  });
  buildTable(container,'tblCons','📊 Resumen Consolidado por Lote',
    ['Lote','Plantas','Área (Ha)','Densidad','Costo Siembra','Costo Aplic.','Costo Total','Costo/Ha','Costo/Planta','# Aplic.'],
    rows,rows.length,50);
}

let tablePages={};
function buildTable(container,id,title,headers,rows,total,pageSize=25){
  tablePages[id]={page:0,pageSize,rows,sortCol:-1,sortDir:1};
  const wrap=document.createElement('div');wrap.className='data-table-wrap';
  wrap.innerHTML=`<div class="data-table-header"><h4>${title} <span style="color:var(--t3);font-weight:400;font-size:12px">(${total} registros)</span></h4><input class="dt-search" placeholder="Buscar..." oninput="searchTable('${id}',this.value)"></div><div id="${id}-body"></div>`;
  container.appendChild(wrap);
  renderTablePage(id);
}
function renderTablePage(id){
  const st=tablePages[id];
  let rows=st.filteredRows||st.rows;
  if(st.sortCol>=0){rows=[...rows].sort((a,b)=>{let va=a[st.sortCol],vb=b[st.sortCol];if(typeof va==='object')va=va.v;if(typeof vb==='object')vb=vb.v;const na=parseFloat(String(va).replace(/[₡,\s]/g,'')),nb=parseFloat(String(vb).replace(/[₡,\s,]/g,''));if(!isNaN(na)&&!isNaN(nb))return(na-nb)*st.sortDir;return String(va).localeCompare(String(vb))*st.sortDir})}
  const start=st.page*st.pageSize,end=Math.min(start+st.pageSize,rows.length);
  const pageRows=rows.slice(start,end);
  const headers=st.headers||[];
  const body=document.getElementById(id+'-body');
  let html='<table class="data-table"><thead><tr>';
  const thLabels=document.querySelector(`#${id}-body`)?.previousElementSibling?null:null;
  // We need headers from the parent - store them
  if(!tablePages[id].headerLabels){
    const headerEl=body.parentElement.querySelector('.data-table-header h4');
    // just use from call
  }
  html+='</tr></thead><tbody>';
  pageRows.forEach(row=>{
    html+='<tr>';
    row.forEach(cell=>{
      if(typeof cell==='object'){html+=`<td class="${cell.cls||''}">${cell.v}</td>`}
      else{html+=`<td>${cell}</td>`}
    });
    html+='</tr>';
  });
  html+='</tbody></table>';
  html+=`<div class="pagination"><span>Mostrando ${start+1}-${end} de ${rows.length}</span><div class="page-btns">`;
  html+=`<button class="page-btn" onclick="changePage('${id}',-1)" ${st.page===0?'disabled':''}>◀ Anterior</button>`;
  const totalPages=Math.ceil(rows.length/st.pageSize);
  for(let i=0;i<Math.min(totalPages,7);i++){html+=`<button class="page-btn ${i===st.page?'active':''}" onclick="setPage('${id}',${i})">${i+1}</button>`}
  if(totalPages>7) html+=`<span style="color:var(--t3);padding:0 6px">...${totalPages}</span>`;
  html+=`<button class="page-btn" onclick="changePage('${id}',1)" ${st.page>=totalPages-1?'disabled':''}>Siguiente ▶</button></div></div>`;
  body.innerHTML=html;
}
function changePage(id,dir){tablePages[id].page+=dir;renderTablePage(id)}
function setPage(id,p){tablePages[id].page=p;renderTablePage(id)}
function searchTable(id,q){
  const st=tablePages[id];
  if(!q){st.filteredRows=null}else{
    const ql=q.toLowerCase();
    st.filteredRows=st.rows.filter(row=>row.some(cell=>{const v=typeof cell==='object'?cell.v:cell;return String(v).toLowerCase().includes(ql)}));
  }
  st.page=0;renderTablePage(id);
}

// ═══════════════════════════════════════════════
// RENDER ALL
// ═══════════════════════════════════════════════
function renderAll(){
  if(currentTab==='siembra'){renderKpiSiembra();renderChartsSiembra();renderTableSiembra()}
  else if(currentTab==='aplicaciones'){renderKpiAplic();renderChartsAplic();renderTableAplic()}
  else{renderKpiConsolidado();renderChartsConsolidado();renderTableConsolidado()}
}

// ═══════════════════════════════════════════════
// EVENT HANDLERS
// ═══════════════════════════════════════════════
document.querySelectorAll('.tab').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    currentTab=btn.dataset.tab;
    document.getElementById('panel-'+currentTab).classList.add('active');
    // Toggle filter visibility
    const isAdmin=currentTab==='admin';
    document.getElementById('filtersBar').style.display=isAdmin?'none':'flex';
    if(!isAdmin){
      document.getElementById('fgMaterial').style.display=currentTab==='aplicaciones'?'none':'flex';
      document.getElementById('fgProced').style.display=currentTab==='aplicaciones'?'none':'flex';
      document.getElementById('fgEtapa').style.display=currentTab==='siembra'?'none':'flex';
      document.getElementById('fgLabor').style.display=currentTab==='siembra'?'none':'flex';
      document.getElementById('fSemana').parentElement.style.display=currentTab==='aplicaciones'?'none':'flex';
      renderAll();
    } else { updateAdminStats(); }
  });
});

['fLote','fSemana','fMaterial','fProced','fEtapa','fLabor'].forEach(id=>{
  document.getElementById(id).addEventListener('change',e=>{
    const key=id.replace('f','').toLowerCase();
    filters[key]=e.target.value;
    updateFilterChips();
    renderAll();
  });
});

function updateFilterChips(){
  const el=document.getElementById('activeFilters');
  const clearBtn=document.getElementById('clearFilters');
  let html='';
  const names={lote:'Lote',semana:'Semana',material:'Material',proced:'Procedencia',etapa:'Etapa',labor:'Labor'};
  let any=false;
  for(const[k,v]of Object.entries(filters)){
    if(v){html+=`<span class="filter-chip" onclick="removeFilter('${k}')">${names[k]}: ${v} <span class="x">✕</span></span>`;any=true}
  }
  el.innerHTML=html;
  clearBtn.style.display=any?'inline-flex':'none';
}
document.getElementById('clearFilters').addEventListener('click',()=>{
  filters={lote:'',semana:'',material:'',proced:'',etapa:'',labor:''};
  ['fLote','fSemana','fMaterial','fProced','fEtapa','fLabor'].forEach(id=>document.getElementById(id).value='');
  updateFilterChips();renderAll();
});
function removeFilter(key){
  filters[key]='';
  const selectMap={lote:'fLote',semana:'fSemana',material:'fMaterial',proced:'fProced',etapa:'fEtapa',labor:'fLabor'};
  document.getElementById(selectMap[key]).value='';
  updateFilterChips();renderAll();
}

// ═══════════════════════════════════════════════
// ADMIN PANEL
// ═══════════════════════════════════════════════
const ADMIN_PIN = '130680';
let adminUnlocked = false;

function verifyAdminPin(){
  const pin = document.getElementById('adminPinInput').value;
  if(pin === ADMIN_PIN){
    adminUnlocked = true;
    document.getElementById('adminGate').style.display = 'none';
    document.getElementById('adminPanel').style.display = 'block';
    document.getElementById('pinError').textContent = '';
    updateAdminStats();
  } else {
    document.getElementById('pinError').textContent = '❌ PIN incorrecto. Intente de nuevo.';
    document.getElementById('adminPinInput').value = '';
    document.getElementById('adminPinInput').focus();
  }
}

function lockAdmin(){
  adminUnlocked = false;
  document.getElementById('adminGate').style.display = 'block';
  document.getElementById('adminPanel').style.display = 'none';
  document.getElementById('adminPinInput').value = '';
}

function updateAdminStats(){
  document.getElementById('currentSiembraCount').textContent = siembraRaw.length.toLocaleString('es');
  document.getElementById('currentAplicCount').textContent = aplicRaw.length.toLocaleString('es');
  document.getElementById('currentSiembraLotes').textContent = new Set(siembraRaw.map(r=>r.lote)).size;
  document.getElementById('currentAplicLotes').textContent = new Set(aplicRaw.map(r=>r.lote)).size;
}

// File input handlers
document.getElementById('fileSiembra').addEventListener('change', function(e){
  const f = e.target.files[0];
  document.getElementById('nameSiembra').textContent = f ? '📎 ' + f.name : '';
  checkUploadBtn();
});
document.getElementById('fileAplic').addEventListener('change', function(e){
  const f = e.target.files[0];
  document.getElementById('nameAplic').textContent = f ? '📎 ' + f.name : '';
  checkUploadBtn();
});

function checkUploadBtn(){
  const s = document.getElementById('fileSiembra').files.length > 0;
  const a = document.getElementById('fileAplic').files.length > 0;
  document.getElementById('btnUpload').disabled = !(s || a);
}

// Drag & drop
['dropSiembra','dropAplic'].forEach(id=>{
  const el = document.getElementById(id);
  const inputId = id === 'dropSiembra' ? 'fileSiembra' : 'fileAplic';
  el.addEventListener('dragover', e => { e.preventDefault(); el.classList.add('dragover'); });
  el.addEventListener('dragleave', () => el.classList.remove('dragover'));
  el.addEventListener('drop', e => {
    e.preventDefault(); el.classList.remove('dragover');
    const dt = new DataTransfer();
    if(e.dataTransfer.files.length) dt.items.add(e.dataTransfer.files[0]);
    document.getElementById(inputId).files = dt.files;
    document.getElementById(inputId).dispatchEvent(new Event('change'));
  });
});

// PIN input enter key
document.getElementById('adminPinInput').addEventListener('keydown', function(e){
  if(e.key === 'Enter') verifyAdminPin();
});

// Upload handler
async function uploadData(){
  const btn = document.getElementById('btnUpload');
  const resultEl = document.getElementById('uploadResult');
  const siembraFile = document.getElementById('fileSiembra').files[0];
  const aplicFile = document.getElementById('fileAplic').files[0];
  
  if(!siembraFile && !aplicFile){
    resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error</h5>Seleccione al menos un archivo</div>';
    return;
  }

  // Confirm
  const parts = [];
  if(siembraFile) parts.push('Siembra ('+siembraFile.name+')');
  if(aplicFile) parts.push('Aplicaciones ('+aplicFile.name+')');
  if(!confirm('¿Está seguro de reemplazar la base de datos de: '+parts.join(' y ')+'?\n\nEsta acción no se puede deshacer.')) return;

  btn.disabled = true;
  btn.textContent = '⏳ Procesando...';
  resultEl.innerHTML = '<div class="upload-result"><h5>⏳ Subiendo y procesando archivos...</h5>Esto puede tomar unos segundos...</div>';

  try {
    const fd = new FormData();
    fd.append('pin', ADMIN_PIN);
    if(siembraFile) fd.append('siembraFile', siembraFile);
    if(aplicFile) fd.append('aplicFile', aplicFile);

    const resp = await fetch('/api/update-siembra', { method: 'POST', body: fd });
    const data = await resp.json();

    if(!resp.ok){
      resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error</h5>'+data.error+'</div>';
      return;
    }

    let html = '<div class="upload-result success"><h5>✅ Base de datos actualizada correctamente</h5>';
    if(data.siembra) html += '<p>🌾 Siembra: <strong>'+data.siembra.registros+'</strong> registros cargados desde '+data.siembra.fileName+'</p>';
    if(data.aplicaciones) html += '<p>🧪 Aplicaciones: <strong>'+data.aplicaciones.registros+'</strong> registros cargados desde '+data.aplicaciones.fileName+'</p>';
    html += '<p style="margin-top:8px;font-size:11px;color:var(--t3)">Tamaño del archivo: '+data.htmlSizeKB+' KB</p>';
    html += '<p style="margin-top:12px;font-weight:700;color:#f59e0b">🔄 La página se recargará en 3 segundos con los datos actualizados...</p></div>';
    resultEl.innerHTML = html;

    // Clear file inputs
    document.getElementById('fileSiembra').value = '';
    document.getElementById('fileAplic').value = '';
    document.getElementById('nameSiembra').textContent = '';
    document.getElementById('nameAplic').textContent = '';

    setTimeout(() => window.location.reload(), 3000);
  } catch(err){
    resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error de conexión</h5>'+err.message+'</div>';
  } finally {
    btn.disabled = false;
    btn.textContent = '📤 Actualizar Base de Datos';
    checkUploadBtn();
  }
}

// INIT
populateFilters();
renderAll();
</script>
</body>
</html>
