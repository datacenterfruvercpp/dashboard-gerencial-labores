<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#05070a;--bg2:#0c1017;--bg3:#111827;--bg4:#1a1f35;--bdr:#1b2436;--bdr2:#2d3a52;--t1:#f1f5f9;--t2:#94a3b8;--t3:#64748b;--blue:#3b82f6;--indigo:#6366f1;--purple:#8b5cf6;--emerald:#10b981;--amber:#f59e0b;--red:#ef4444;--cyan:#06b6d4;--lime:#84cc16;--pink:#ec4899;--teal:#14b8a6;--orange:#f97316}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--t1);min-height:100vh;overflow-x:hidden}

/* HEADER */
.hdr{background:linear-gradient(135deg,#0f172a,#1e1b4b 60%,#0c1017);border-bottom:1px solid var(--bdr);padding:20px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;position:sticky;top:0;z-index:100;backdrop-filter:blur(12px)}
.hdr-left{display:flex;align-items:center;gap:14px}
.hdr-logo{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--emerald),var(--teal));display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 20px rgba(16,185,129,.25)}
.hdr h1{font-size:18px;font-weight:800;letter-spacing:-.3px}
.hdr h1 span{font-weight:400;color:var(--t3);font-size:13px;margin-left:8px}

/* TABS */
.tabs{display:flex;gap:4px}
.tab{background:transparent;border:1px solid transparent;color:var(--t3);font:600 13px/1 'Inter',sans-serif;padding:10px 20px;border-radius:10px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:7px;white-space:nowrap}
.tab:hover{color:var(--t2);background:rgba(99,102,241,.06)}
.tab.active{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.2);color:var(--indigo)}

/* FILTERS */
.filters-bar{background:var(--bg2);border-bottom:1px solid var(--bdr);padding:12px 28px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.filter-group{display:flex;align-items:center;gap:6px}
.filter-group label{font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:.8px;font-weight:600}
.filter-select{background:var(--bg3);border:1px solid var(--bdr);color:var(--t1);font:500 12px/1 'Inter',sans-serif;padding:7px 12px;border-radius:8px;min-width:100px;cursor:pointer}
.filter-select:focus{outline:none;border-color:var(--indigo)}
.filter-chip{display:inline-flex;align-items:center;gap:4px;background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.2);color:var(--indigo);font-size:11px;font-weight:600;padding:5px 10px;border-radius:6px;cursor:pointer;transition:.2s}
.filter-chip:hover{background:rgba(99,102,241,.2)}
.filter-chip .x{font-size:14px;margin-left:2px;opacity:.6}
.clear-btn{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.15);color:#fca5a5;font:600 11px/1 'Inter',sans-serif;padding:6px 12px;border-radius:6px;cursor:pointer;transition:.2s}
.clear-btn:hover{background:rgba(239,68,68,.2)}

/* LAYOUT */
.main{padding:20px 28px 60px}
.tab-panel{display:none;animation:fadeIn .3s}
.tab-panel.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* KPI CARDS */
.kpi-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:24px}
.kpi{background:var(--bg2);border:1px solid var(--bdr);border-radius:14px;padding:18px 20px;position:relative;overflow:hidden;transition:.2s}
.kpi:hover{border-color:var(--bdr2);transform:translateY(-2px)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:14px 14px 0 0}
.kpi .kpi-icon{font-size:22px;margin-bottom:8px}
.kpi .kpi-label{font-size:10px;text-transform:uppercase;letter-spacing:1px;font-weight:700;color:var(--t3);margin-bottom:6px}
.kpi .kpi-value{font-size:26px;font-weight:800;letter-spacing:-.5px}
.kpi .kpi-sub{font-size:11px;color:var(--t3);margin-top:4px;font-weight:500}

/* CHART GRID */
.chart-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:24px}
.chart-grid.triple{grid-template-columns:repeat(3,1fr)}
.chart-box{background:var(--bg2);border:1px solid var(--bdr);border-radius:16px;padding:20px;transition:.2s;min-height:320px}
.chart-box:hover{border-color:var(--bdr2)}
.chart-box.full{grid-column:1/-1}
.chart-box.span2{grid-column:span 2}
.chart-title{font-size:14px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px}
.chart-subtitle{font-size:11px;color:var(--t3);margin-bottom:16px}
.chart-wrap{position:relative;width:100%;height:280px}
.chart-wrap.tall{height:380px}
.chart-wrap canvas{width:100%!important;height:100%!important}

/* TABLE */
.data-table-wrap{background:var(--bg2);border:1px solid var(--bdr);border-radius:16px;overflow:hidden;margin-bottom:24px}
.data-table-header{padding:16px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bdr)}
.data-table-header h4{font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px}
.dt-search{background:var(--bg3);border:1px solid var(--bdr);color:var(--t1);font:400 12px/1 'Inter',sans-serif;padding:7px 12px;border-radius:8px;width:200px}
.dt-search:focus{outline:none;border-color:var(--indigo)}
.data-table{width:100%;border-collapse:collapse}
.data-table th{background:rgba(99,102,241,.04);padding:10px 16px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.8px;font-weight:700;color:var(--t3);border-bottom:1px solid var(--bdr);cursor:pointer;user-select:none;white-space:nowrap;position:relative}
.data-table th:hover{color:var(--t2)}
.data-table th .sort-icon{margin-left:4px;opacity:.4;font-size:10px}
.data-table th.sorted .sort-icon{opacity:1;color:var(--indigo)}
.data-table td{padding:10px 16px;font-size:12px;color:var(--t2);border-bottom:1px solid rgba(27,36,54,.5);white-space:nowrap}
.data-table tr:hover td{background:rgba(99,102,241,.02)}
.data-table .num{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
.data-table .money{color:var(--emerald)}
.pagination{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-top:1px solid var(--bdr)}
.pagination span{font-size:12px;color:var(--t3)}
.page-btns{display:flex;gap:4px}
.page-btn{background:var(--bg3);border:1px solid var(--bdr);color:var(--t2);font:600 11px/1 'Inter',sans-serif;padding:6px 12px;border-radius:6px;cursor:pointer}
.page-btn:hover{border-color:var(--bdr2)}
.page-btn.active{background:rgba(99,102,241,.15);border-color:rgba(99,102,241,.3);color:var(--indigo)}
.page-btn:disabled{opacity:.3;cursor:default}

/* MISC */
.section-title{font-size:18px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.section-title .st-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px}
.badge{display:inline-flex;padding:3px 8px;border-radius:5px;font-size:10px;font-weight:700}
.lote-tag{background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.15);color:#a5b4fc;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;transition:.2s}
.lote-tag:hover{background:rgba(99,102,241,.2)}
.lote-tag.active{background:rgba(99,102,241,.3);border-color:rgba(99,102,241,.4)}

/* ADMIN */
.admin-gate{max-width:420px;margin:60px auto;text-align:center}
.admin-gate h3{font-size:20px;font-weight:700;margin-bottom:8px}
.admin-gate p{font-size:13px;color:var(--t3);margin-bottom:24px}
.admin-gate .pin-input{background:var(--bg3);border:2px solid var(--bdr);color:var(--t1);font:700 24px/1 'Inter',monospace;padding:14px 20px;border-radius:12px;width:200px;text-align:center;letter-spacing:8px}
.admin-gate .pin-input:focus{outline:none;border-color:var(--indigo)}
.admin-gate .pin-btn{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;padding:12px 32px;border-radius:10px;font:700 14px/1 'Inter',sans-serif;cursor:pointer;margin-top:16px;transition:.2s}
.admin-gate .pin-btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(99,102,241,.4)}
.admin-gate .pin-error{color:#ef4444;font-size:13px;margin-top:12px;font-weight:600}
.admin-panel{max-width:900px;margin:0 auto;padding:20px 0}
.upload-zone{background:var(--bg2);border:2px dashed var(--bdr);border-radius:16px;padding:40px 30px;text-align:center;margin-bottom:24px;transition:.3s;cursor:pointer}
.upload-zone:hover,.upload-zone.dragover{border-color:var(--indigo);background:rgba(99,102,241,.03)}
.upload-zone .uz-icon{font-size:40px;margin-bottom:12px}
.upload-zone h4{font-size:16px;font-weight:700;margin-bottom:6px}
.upload-zone p{font-size:12px;color:var(--t3)}
.upload-zone input[type=file]{display:none}
.upload-zone .uz-file-name{margin-top:12px;font-size:13px;color:var(--indigo);font-weight:600}
.upload-btn{background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;padding:14px 40px;border-radius:12px;font:700 15px/1 'Inter',sans-serif;cursor:pointer;transition:.2s;margin-top:8px}
.upload-btn:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(16,185,129,.4)}
.upload-btn:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.upload-result{background:var(--bg2);border:1px solid var(--bdr);border-radius:12px;padding:20px;margin-top:16px;font-size:13px}
.upload-result.success{border-color:rgba(16,185,129,.3)}
.upload-result.error{border-color:rgba(239,68,68,.3)}
.upload-result h5{font-size:15px;font-weight:700;margin-bottom:8px}
.admin-header{display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--bdr)}
.admin-header .admin-icon{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,rgba(99,102,241,.15),rgba(139,92,246,.15));display:flex;align-items:center;justify-content:center;font-size:22px}
.admin-header h3{font-size:18px;font-weight:700}
.admin-header p{font-size:12px;color:var(--t3)}
.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
@media(max-width:700px){.upload-grid{grid-template-columns:1fr}}
.admin-logout{background:var(--bg3);border:1px solid var(--bdr);color:var(--t3);padding:8px 16px;border-radius:8px;font:600 12px/1 'Inter',sans-serif;cursor:pointer;margin-left:auto}
.admin-logout:hover{border-color:var(--bdr2);color:var(--t2)}

@media(max-width:900px){.chart-grid,.chart-grid.triple{grid-template-columns:1fr}.kpi-row{grid-template-columns:repeat(2,1fr)}.hdr{flex-direction:column;align-items:flex-start}.tabs{overflow-x:auto;width:100%}}
@media print{.hdr,.filters-bar{position:static}body{background:#fff;color:#1e293b}}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--bdr);border-radius:3px}
</style>
</head>
<body>

<header class="hdr">
  <div class="hdr-left">
    <div class="hdr-logo">🌱</div>
    <h1>Siembra y Costos Labagric <span>Dashboard Gerencial</span></h1>
  </div>
  <div class="tabs" id="mainTabs">
    <button class="tab active" data-tab="siembra">🌾 Costos de Siembra</button>
    <button class="tab" data-tab="aplicaciones">🧪 Costos de Aplicaciones</button>
    <button class="tab" data-tab="planillas">💼 Costos de Planillas</button>
    <button class="tab" data-tab="consolidado">📊 Consolidado Total</button>
    <button class="tab" data-tab="admin" style="margin-left:auto;opacity:.7">🔐 Admin</button>
  </div>
</header>

<div class="filters-bar" id="filtersBar">
  <div class="filter-group"><label>Lote:</label><select class="filter-select" id="fLote"><option value="">Todos</option></select></div>
  <div class="filter-group"><label>Semana:</label><select class="filter-select" id="fSemana"><option value="">Todas</option></select></div>
  <div class="filter-group" id="fgMaterial"><label>Material:</label><select class="filter-select" id="fMaterial"><option value="">Todos</option></select></div>
  <div class="filter-group" id="fgProced"><label>Procedencia:</label><select class="filter-select" id="fProced"><option value="">Todas</option></select></div>
  <div class="filter-group" id="fgEtapa" style="display:none"><label>Etapa:</label><select class="filter-select" id="fEtapa"><option value="">Todas</option></select></div>
  <div class="filter-group" id="fgLabor" style="display:none"><label>Labor:</label><select class="filter-select" id="fLabor"><option value="">Todas</option></select></div>
  <div id="activeFilters" style="display:flex;gap:6px;flex-wrap:wrap"></div>
  <button class="clear-btn" id="clearFilters" style="display:none">✕ Limpiar Filtros</button>
</div>

<div class="main">
  <!-- ═══ SIEMBRA ═══ -->
  <div class="tab-panel active" id="panel-siembra">
    <div class="kpi-row" id="kpiSiembra"></div>
    <div class="chart-grid" id="chartsSiembra"></div>
    <div id="tableSiembra"></div>
  </div>
  <!-- ═══ APLICACIONES ═══ -->
  <div class="tab-panel" id="panel-aplicaciones">
    <div class="kpi-row" id="kpiAplic"></div>
    <div class="chart-grid" id="chartsAplic"></div>
    <div id="tableAplic"></div>
  </div>
  <!-- ═══ PLANILLAS ═══ -->
  <div class="tab-panel" id="panel-planillas">
    <div class="kpi-row" id="kpiPlanillas"></div>
    <div class="chart-grid" id="chartsPlanillas"></div>
    <div id="tablePlanillas"></div>
  </div>
  <!-- ═══ CONSOLIDADO ═══ -->
  <div class="tab-panel" id="panel-consolidado">
    <div class="kpi-row" id="kpiConsolidado"></div>
    <div class="chart-grid" id="chartsConsolidado"></div>
    <div id="tableConsolidado"></div>
  </div>
  <!-- ═══ ADMIN ═══ -->
  <div class="tab-panel" id="panel-admin">
    <div id="adminGate" class="admin-gate">
      <div style="font-size:48px;margin-bottom:16px">🔐</div>
      <h3>Acceso Administrativo</h3>
      <p>Ingrese el PIN para acceder al panel de actualización de datos</p>
      <input type="password" class="pin-input" id="adminPinInput" maxlength="6" placeholder="••••••">
      <br>
      <button class="pin-btn" onclick="verifyAdminPin()">🔓 Desbloquear</button>
      <div class="pin-error" id="pinError"></div>
    </div>
    <div id="adminPanel" class="admin-panel" style="display:none">
      <div class="admin-header">
        <div class="admin-icon">⚙️</div>
        <div>
          <h3>Panel de Actualización de Datos</h3>
          <p>Suba archivos Excel (.xlsx) para reemplazar la base de datos actual</p>
        </div>
        <button class="admin-logout" onclick="lockAdmin()">🔒 Bloquear</button>
      </div>
      <div class="upload-grid">
        <div class="upload-zone" id="dropSiembra" onclick="document.getElementById('fileSiembra').click()">
          <div class="uz-icon">🌾</div>
          <h4>Base de Datos de Siembra</h4>
          <p>Archivo: detalle de siembra.xlsx</p>
          <p style="margin-top:4px;font-size:11px;color:var(--t3)">Columnas: Semana, Fecha, Finca, Lote, Bloque, Terraza, Área, Plantas, Precio, Densidad, Material, Variedad, Tipo, Procedencia</p>
          <input type="file" id="fileSiembra" accept=".xlsx,.xls">
          <div class="uz-file-name" id="nameSiembra"></div>
        </div>
        <div class="upload-zone" id="dropAplic" onclick="document.getElementById('fileAplic').click()">
          <div class="uz-icon">🧪</div>
          <h4>Base de Datos de Aplicaciones</h4>
          <p>Archivo: aplicaciones por lote.xlsx</p>
          <p style="margin-top:4px;font-size:11px;color:var(--t3)">Columnas: Finca, Nombre, Lote, Grupo, Fecha, Etapa, Labor, Producto, Unidad, Cantidad, Precio Unit., Costo Total</p>
          <input type="file" id="fileAplic" accept=".xlsx,.xls">
          <div class="uz-file-name" id="nameAplic"></div>
        </div>
      </div>
      <div style="text-align:center">
        <button class="upload-btn" id="btnUpload" onclick="uploadData()" disabled>📤 Actualizar Base de Datos</button>
        <p style="font-size:11px;color:var(--t3);margin-top:8px">⚠️ Esto reemplazará los datos actuales. Asegúrese de subir archivos correctos.</p>
      </div>
      <div id="uploadResult"></div>
      <div style="margin-top:24px;background:var(--bg2);border:1px solid var(--bdr);border-radius:12px;padding:16px 20px">
        <h5 style="font-size:13px;font-weight:700;margin-bottom:8px">📊 Base de Datos Actual</h5>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:12px;color:var(--t2)">
          <div>🌾 Registros de Siembra: <strong id="currentSiembraCount">0</strong></div>
          <div>🧪 Registros de Aplicaciones: <strong id="currentAplicCount">0</strong></div>
          <div>📍 Lotes de Siembra: <strong id="currentSiembraLotes">0</strong></div>
          <div>📍 Lotes de Aplicaciones: <strong id="currentAplicLotes">0</strong></div>
          <div>💼 Empleados en Planilla: <strong id="currentPlanillaCount">0</strong></div>
          <div>🔧 Labores Registradas: <strong id="currentLaboresCount">0</strong></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════
// DATA ENGINE
// ═══════════════════════════════════════════════
const COLORS = ['#6366f1','#8b5cf6','#3b82f6','#06b6d4','#10b981','#84cc16','#f59e0b','#f97316','#ef4444','#ec4899','#14b8a6','#a855f7','#0ea5e9','#22c55e','#eab308','#d946ef'];
const fmt = n => n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?Math.round(n).toLocaleString('es'):n.toFixed(2);
const fmtMoney = n => '₡'+fmt(n);
const fmtInt = n => Math.round(n).toLocaleString('es');

// Normalize tipo siembra
function normTipo(t){ if(!t)return 'Convencional'; const l=t.toLowerCase(); if(l.includes('semill'))return 'Semillero'; if(l.includes('viver'))return 'Vivero'; return 'Convencional'; }
function normProced(p){ if(!p)return 'Sin Datos'; const u=p.toUpperCase().trim(); if(u.includes('VISA'))return 'VISA'; if(u.includes('NORTE'))return 'Norteñas'; if(u==='CPP')return 'CPP'; if(u.includes('FINCA'))return 'Finca Once'; if(u==='')return 'Sin Datos'; return p.trim(); }

let siembraRaw = RAW_DATA.siembra || [];
let aplicRaw = RAW_DATA.aplicaciones || [];

// Compute costo for siembra
siembraRaw.forEach(r=>{ r.costo = r.plantas * r.precio; r.tipoNorm = normTipo(r.tipo); r.procedNorm = normProced(r.proced); });

// State
let currentTab = 'siembra';
let filters = { lote:'', semana:'', material:'', proced:'', etapa:'', labor:'' };
let charts = {};

// ═══════════════════════════════════════════════
// FILTER ENGINE
// ═══════════════════════════════════════════════
function getFilteredSiembra(){
  let d = siembraRaw;
  if(filters.lote) d = d.filter(r=>r.lote===filters.lote);
  if(filters.semana) d = d.filter(r=>String(r.sem)===filters.semana);
  if(filters.material) d = d.filter(r=>r.material===filters.material);
  if(filters.proced) d = d.filter(r=>r.procedNorm===filters.proced);
  return d;
}
function getFilteredAplic(){
  let d = aplicRaw;
  if(filters.lote) d = d.filter(r=>r.lote===filters.lote);
  if(filters.etapa) d = d.filter(r=>r.etapa===filters.etapa);
  if(filters.labor) d = d.filter(r=>r.labor===filters.labor);
  return d;
}

function populateFilters(){
  const lotes = [...new Set([...siembraRaw.map(r=>r.lote),...aplicRaw.map(r=>r.lote)])].filter(Boolean).sort();
  const semanas = [...new Set(siembraRaw.map(r=>String(r.sem)))].sort((a,b)=>+a-+b);
  const materiales = [...new Set(siembraRaw.map(r=>r.material))].filter(Boolean).sort();
  const procedencias = [...new Set(siembraRaw.map(r=>r.procedNorm))].filter(Boolean).sort();
  const etapas = [...new Set(aplicRaw.map(r=>r.etapa))].filter(Boolean).sort();
  const labores = [...new Set(aplicRaw.map(r=>r.labor))].filter(Boolean).sort();
  
  fillSelect('fLote',lotes); fillSelect('fSemana',semanas); fillSelect('fMaterial',materiales);
  fillSelect('fProced',procedencias); fillSelect('fEtapa',etapas); fillSelect('fLabor',labores);
}
function fillSelect(id,items){
  const s=document.getElementById(id);
  const first=s.options[0].text;
  s.innerHTML='<option value="">'+first+'</option>';
  items.forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;s.appendChild(o)});
}

// ═══════════════════════════════════════════════
// KPI BUILDER
// ═══════════════════════════════════════════════
function kpiCard(icon,label,value,sub,color){
  return `<div class="kpi" style="--c:${color}"><div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,${color},${color}88);border-radius:14px 14px 0 0"></div><div class="kpi-icon">${icon}</div><div class="kpi-label">${label}</div><div class="kpi-value" style="color:${color}">${value}</div><div class="kpi-sub">${sub}</div></div>`;
}

function renderKpiSiembra(){
  const d=getFilteredSiembra();
  const totalPlantas=d.reduce((s,r)=>s+r.plantas,0);
  const totalCosto=d.reduce((s,r)=>s+r.costo,0);
  const totalArea=d.reduce((s,r)=>s+r.area,0);
  const lotes=[...new Set(d.map(r=>r.lote))].length;
  const semanas=[...new Set(d.map(r=>r.sem))].length;
  const avgDensidad=d.length?d.reduce((s,r)=>s+r.densidad,0)/d.length:0;
  const costoPorPlanta=totalPlantas?totalCosto/totalPlantas:0;
  const plantasPorHa=totalArea?totalPlantas/totalArea:0;
  const proveedores=[...new Set(d.map(r=>r.procedNorm))].filter(Boolean);
  const topProveedor=getTopN(d,'procedNorm','plantas',1);
  document.getElementById('kpiSiembra').innerHTML=[
    kpiCard('🌱','Total Plantas Sembradas',fmtInt(totalPlantas),`${d.length} registros`,'#10b981'),
    kpiCard('💰','Inversión Total en Siembra',fmtMoney(totalCosto),'Costo acumulado','#f59e0b'),
    kpiCard('📐','Área Total Sembrada',fmt(totalArea)+' Ha',lotes+' lotes activos','#3b82f6'),
    kpiCard('📊','Densidad Promedio',fmtInt(avgDensidad),'plantas/Ha promedio','#8b5cf6'),
    kpiCard('💵','Costo por Planta','₡'+costoPorPlanta.toFixed(2),'promedio general','#06b6d4'),
    kpiCard('📅','Semanas Registradas',semanas,'período de siembra','#ec4899'),
    kpiCard('🏢','Proveedores de Semilla',proveedores.length,proveedores.join(', '),'#f97316'),
    kpiCard('🥇','Proveedor Principal',topProveedor.length?topProveedor[0][0]:'N/A',topProveedor.length?fmtInt(topProveedor[0][1])+' plantas':'','#14b8a6'),
    kpiCard('🏷️','Precio Unitario','₡'+((d.length?d.reduce((s,r)=>s+r.precio,0)/d.length:0).toFixed(2)),'precio promedio material','#14b8a6'),
    kpiCard('🌿','Plantas por Hectárea',fmtInt(plantasPorHa),'rendimiento de siembra','#84cc16'),
  ].join('');
}

function renderKpiAplic(){
  const d=getFilteredAplic();
  const totalCosto=d.reduce((s,r)=>s+r.costoTotal,0);
  const productos=[...new Set(d.map(r=>r.producto))].length;
  const labores=[...new Set(d.map(r=>r.labor))].length;
  const lotes=[...new Set(d.map(r=>r.lote))].length;
  const etapas=[...new Set(d.map(r=>r.etapa))].filter(Boolean).length;
  const conCosto=d.filter(r=>r.costoTotal>0);
  const avgCosto=conCosto.length?totalCosto/conCosto.length:0;
  const maxProd=getTopN(d,'producto','costoTotal',1);
  document.getElementById('kpiAplic').innerHTML=[
    kpiCard('💰','Inversión Total Aplicaciones',fmtMoney(totalCosto),`${d.length} aplicaciones`,'#ef4444'),
    kpiCard('🧪','Productos Utilizados',productos,'productos distintos','#8b5cf6'),
    kpiCard('🔧','Labores Realizadas',labores,'tipos de labor','#3b82f6'),
    kpiCard('📍','Lotes Tratados',lotes,'lotes con aplicaciones','#10b981'),
    kpiCard('📊','Etapas Cubiertas',etapas,'del ciclo productivo','#f59e0b'),
    kpiCard('💵','Costo Promedio/Aplicación','₡'+fmt(avgCosto),'por registro con costo','#06b6d4'),
    kpiCard('🏆','Producto Más Costoso',maxProd.length?maxProd[0][0].substring(0,18):'N/A',maxProd.length?fmtMoney(maxProd[0][1]):'','#ec4899'),
    kpiCard('📅','Registros Procesados',fmtInt(d.length),'líneas de aplicación','#14b8a6'),
  ].join('');
}

function renderKpiConsolidado(){
  const ds=getFilteredSiembra(), da=getFilteredAplic();
  const costoS=ds.reduce((s,r)=>s+r.costo,0);
  const costoA=da.reduce((s,r)=>s+r.costoTotal,0);
  const costoPlanBruto=nominaRaw.reduce((s,r)=>s+r.salTotal,0);
  const costoPlanCCSS=nominaRaw.reduce((s,r)=>s+r.seguro,0);
  const costoPlanTotal=costoPlanBruto+costoPlanCCSS;
  const costoLabores=laboresResumen.reduce((s,r)=>s+r.total,0);
  const total=costoS+costoA+costoPlanTotal;
  const pctS=total?((costoS/total)*100).toFixed(1):0;
  const pctA=total?((costoA/total)*100).toFixed(1):0;
  const pctP=total?((costoPlanTotal/total)*100).toFixed(1):0;
  const totalPlantas=ds.reduce((s,r)=>s+r.plantas,0);
  const totalArea=ds.reduce((s,r)=>s+r.area,0);
  const costoIntegralPlanta=totalPlantas?(total/totalPlantas):0;
  const costoTotalPorHa=totalArea?(total/totalArea):0;
  const lotes=[...new Set([...ds.map(r=>r.lote),...da.map(r=>r.lote)])].length;
  document.getElementById('kpiConsolidado').innerHTML=[
    kpiCard('🏦','Inversión Total General',fmtMoney(total),'siembra + aplicaciones + planillas','#6366f1'),
    kpiCard('🌱','Costo de Siembra',fmtMoney(costoS),pctS+'% del total','#10b981'),
    kpiCard('🧪','Costo de Aplicaciones',fmtMoney(costoA),pctA+'% del total','#ef4444'),
    kpiCard('💼','Costo de Planillas',fmtMoney(costoPlanTotal),pctP+'% del total (bruto+CCSS)','#8b5cf6'),
    kpiCard('🌿','Costo Total / Hectárea',fmtMoney(costoTotalPorHa),totalArea.toFixed(2)+' Ha totales','#e11d48'),
    kpiCard('📊','Costo Integral/Planta','₡'+costoIntegralPlanta.toFixed(2),'costo total / planta','#f59e0b'),
    kpiCard('🌾','Total Plantas',fmtInt(totalPlantas),'plantas sembradas','#84cc16'),
    kpiCard('📍','Lotes Operados',lotes,'lotes en operación','#3b82f6'),
    kpiCard('👥','Empleados en Planilla',nominaRaw.length,'personal activo','#06b6d4'),
    kpiCard('🔧','Labores Registradas',laboresResumen.length,fmtInt(laboresResumen.reduce((s,r)=>s+r.cantidad,0))+' horas','#14b8a6'),
  ].join('');
}

// ═══════════════════════════════════════════════
// CHART HELPERS
// ═══════════════════════════════════════════════
function getTopN(arr,key,valKey,n=10){
  const map={};
  arr.forEach(r=>{const k=r[key];if(k)map[k]=(map[k]||0)+(r[valKey]||0)});
  return Object.entries(map).sort((a,b)=>b[1]-a[1]).slice(0,n);
}
function groupBy(arr,key,valKey){
  const map={};
  arr.forEach(r=>{const k=r[key];if(k)map[k]=(map[k]||0)+(r[valKey]||0)});
  return Object.entries(map).sort((a,b)=>a[0]>b[0]?1:-1);
}
function groupByCount(arr,key){
  const map={};
  arr.forEach(r=>{const k=r[key];if(k)map[k]=(map[k]||0)+1});
  return Object.entries(map).sort((a,b)=>b[1]-a[1]);
}

const chartDefaults = { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:true,position:'bottom',labels:{color:'#94a3b8',font:{size:10,family:'Inter'},boxWidth:10,padding:8}},tooltip:{backgroundColor:'#1e293b',titleColor:'#f1f5f9',bodyColor:'#94a3b8',borderColor:'#334155',borderWidth:1,padding:10,titleFont:{weight:'700'},callbacks:{}}}, scales:{x:{ticks:{color:'#64748b',font:{size:10}},grid:{color:'rgba(30,37,64,.4)'}},y:{ticks:{color:'#64748b',font:{size:10},callback:function(v){return v>=1e6?(v/1e6).toFixed(1)+'M':v>=1e3?(v/1e3).toFixed(0)+'K':v}},grid:{color:'rgba(30,37,64,.4)'}}} };

function makeChart(containerId,id,title,subtitle,type,labels,datasets,opts={}){
  const container=document.getElementById(containerId);
  const cls = opts.full?'chart-box full':opts.span2?'chart-box span2':'chart-box';
  const tallCls = opts.tall?'chart-wrap tall':'chart-wrap';
  const div=document.createElement('div');div.className=cls;
  div.innerHTML=`<div class="chart-title">${title}</div><div class="chart-subtitle">${subtitle}</div><div class="${tallCls}"><canvas id="${id}"></canvas></div>`;
  container.appendChild(div);
  
  const cfg = JSON.parse(JSON.stringify(chartDefaults));
  if(type==='doughnut'||type==='pie'||type==='polarArea'){delete cfg.scales}
  if(opts.indexAxis) cfg.indexAxis='y';
  if(opts.stacked){cfg.scales.x.stacked=true;cfg.scales.y.stacked=true}
  if(opts.noLegend) cfg.plugins.legend.display=false;
  if(opts.moneyTooltip){cfg.plugins.tooltip.callbacks.label=function(ctx){const val=opts.indexAxis?ctx.parsed.x:ctx.parsed.y;return ctx.dataset.label+': ₡'+Math.round(val||0).toLocaleString('es')}}
  if(opts.moneyTooltipPie){cfg.plugins.tooltip.callbacks.label=function(ctx){return ctx.label+': ₡'+Math.round(ctx.parsed||0).toLocaleString('es')}}
  
  if(charts[id]){charts[id].destroy()}
  charts[id]=new Chart(document.getElementById(id),{type,data:{labels,datasets},options:cfg});
}

