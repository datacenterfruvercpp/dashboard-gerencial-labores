const ADMIN_PIN = '130680';
let adminUnlocked = false;

function verifyAdminPin(){
  const pin = document.getElementById('adminPinInput').value;
  if(pin === ADMIN_PIN){
    adminUnlocked = true;
    document.getElementById('adminGate').style.display = 'none';
    document.getElementById('adminPanel').style.display = 'block';
    document.getElementById('pinError').textContent = '';
    updateAdminStats();
  } else {
    document.getElementById('pinError').textContent = '❌ PIN incorrecto. Intente de nuevo.';
    document.getElementById('adminPinInput').value = '';
    document.getElementById('adminPinInput').focus();
  }
}

function lockAdmin(){
  adminUnlocked = false;
  document.getElementById('adminGate').style.display = 'block';
  document.getElementById('adminPanel').style.display = 'none';
  document.getElementById('adminPinInput').value = '';
}

function updateAdminStats(){
  document.getElementById('currentSiembraCount').textContent = siembraRaw.length.toLocaleString('es');
  document.getElementById('currentAplicCount').textContent = aplicRaw.length.toLocaleString('es');
  document.getElementById('currentSiembraLotes').textContent = new Set(siembraRaw.map(r=>r.lote)).size;
  document.getElementById('currentAplicLotes').textContent = new Set(aplicRaw.map(r=>r.lote)).size;
  if(document.getElementById('currentPlanillaCount')) document.getElementById('currentPlanillaCount').textContent = nominaRaw.length;
  if(document.getElementById('currentLaboresCount')) document.getElementById('currentLaboresCount').textContent = laboresResumen.length;
}

// File input handlers
document.getElementById('fileSiembra').addEventListener('change', function(e){
  const f = e.target.files[0];
  document.getElementById('nameSiembra').textContent = f ? '📎 ' + f.name : '';
  checkUploadBtn();
});
document.getElementById('fileAplic').addEventListener('change', function(e){
  const f = e.target.files[0];
  document.getElementById('nameAplic').textContent = f ? '📎 ' + f.name : '';
  checkUploadBtn();
});

function checkUploadBtn(){
  const s = document.getElementById('fileSiembra').files.length > 0;
  const a = document.getElementById('fileAplic').files.length > 0;
  document.getElementById('btnUpload').disabled = !(s || a);
}

// Drag & drop
['dropSiembra','dropAplic'].forEach(id=>{
  const el = document.getElementById(id);
  const inputId = id === 'dropSiembra' ? 'fileSiembra' : 'fileAplic';
  el.addEventListener('dragover', e => { e.preventDefault(); el.classList.add('dragover'); });
  el.addEventListener('dragleave', () => el.classList.remove('dragover'));
  el.addEventListener('drop', e => {
    e.preventDefault(); el.classList.remove('dragover');
    const dt = new DataTransfer();
    if(e.dataTransfer.files.length) dt.items.add(e.dataTransfer.files[0]);
    document.getElementById(inputId).files = dt.files;
    document.getElementById(inputId).dispatchEvent(new Event('change'));
  });
});

// PIN input enter key
document.getElementById('adminPinInput').addEventListener('keydown', function(e){
  if(e.key === 'Enter') verifyAdminPin();
});

// Upload handler
async function uploadData(){
  const btn = document.getElementById('btnUpload');
  const resultEl = document.getElementById('uploadResult');
  const siembraFile = document.getElementById('fileSiembra').files[0];
  const aplicFile = document.getElementById('fileAplic').files[0];
  
  if(!siembraFile && !aplicFile){
    resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error</h5>Seleccione al menos un archivo</div>';
    return;
  }

  // Confirm
  const parts = [];
  if(siembraFile) parts.push('Siembra ('+siembraFile.name+')');
  if(aplicFile) parts.push('Aplicaciones ('+aplicFile.name+')');
  if(!confirm('¿Está seguro de reemplazar la base de datos de: '+parts.join(' y ')+'?\n\nEsta acción no se puede deshacer.')) return;

  btn.disabled = true;
  btn.textContent = '⏳ Procesando...';
  resultEl.innerHTML = '<div class="upload-result"><h5>⏳ Subiendo y procesando archivos...</h5>Esto puede tomar unos segundos...</div>';

  try {
    const fd = new FormData();
    fd.append('pin', ADMIN_PIN);
    if(siembraFile) fd.append('siembraFile', siembraFile);
    if(aplicFile) fd.append('aplicFile', aplicFile);

    const resp = await fetch('/api/update-siembra', { method: 'POST', body: fd });
    const data = await resp.json();

    if(!resp.ok){
      resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error</h5>'+data.error+'</div>';
      return;
    }

    let html = '<div class="upload-result success"><h5>✅ Base de datos actualizada correctamente</h5>';
    if(data.siembra) html += '<p>🌾 Siembra: <strong>'+data.siembra.registros+'</strong> registros cargados desde '+data.siembra.fileName+'</p>';
    if(data.aplicaciones) html += '<p>🧪 Aplicaciones: <strong>'+data.aplicaciones.registros+'</strong> registros cargados desde '+data.aplicaciones.fileName+'</p>';
    html += '<p style="margin-top:8px;font-size:11px;color:var(--t3)">Tamaño del archivo: '+data.htmlSizeKB+' KB</p>';
    html += '<p style="margin-top:12px;font-weight:700;color:#f59e0b">🔄 La página se recargará en 3 segundos con los datos actualizados...</p></div>';
    resultEl.innerHTML = html;

    // Clear file inputs
    document.getElementById('fileSiembra').value = '';
    document.getElementById('fileAplic').value = '';
    document.getElementById('nameSiembra').textContent = '';
    document.getElementById('nameAplic').textContent = '';

    setTimeout(() => window.location.reload(), 3000);
  } catch(err){
    resultEl.innerHTML = '<div class="upload-result error"><h5>❌ Error de conexión</h5>'+err.message+'</div>';
  } finally {
    btn.disabled = false;
    btn.textContent = '📤 Actualizar Base de Datos';
    checkUploadBtn();
  }
}

