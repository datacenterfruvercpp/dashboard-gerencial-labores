let tablePages={};
function buildTable(container,id,title,headers,rows,total,pageSize=25){
  tablePages[id]={page:0,pageSize,rows,sortCol:-1,sortDir:1};
  const wrap=document.createElement('div');wrap.className='data-table-wrap';
  wrap.innerHTML=`<div class="data-table-header"><h4>${title} <span style="color:var(--t3);font-weight:400;font-size:12px">(${total} registros)</span></h4><input class="dt-search" placeholder="Buscar..." oninput="searchTable('${id}',this.value)"></div><div id="${id}-body"></div>`;
  container.appendChild(wrap);
  renderTablePage(id);
}
function renderTablePage(id){
  const st=tablePages[id];
  let rows=st.filteredRows||st.rows;
  if(st.sortCol>=0){rows=[...rows].sort((a,b)=>{let va=a[st.sortCol],vb=b[st.sortCol];if(typeof va==='object')va=va.v;if(typeof vb==='object')vb=vb.v;const na=parseFloat(String(va).replace(/[₡,\s]/g,'')),nb=parseFloat(String(vb).replace(/[₡,\s,]/g,''));if(!isNaN(na)&&!isNaN(nb))return(na-nb)*st.sortDir;return String(va).localeCompare(String(vb))*st.sortDir})}
  const start=st.page*st.pageSize,end=Math.min(start+st.pageSize,rows.length);
  const pageRows=rows.slice(start,end);
  const headers=st.headers||[];
  const body=document.getElementById(id+'-body');
  let html='<table class="data-table"><thead><tr>';
  const thLabels=document.querySelector(`#${id}-body`)?.previousElementSibling?null:null;
  // We need headers from the parent - store them
  if(!tablePages[id].headerLabels){
    const headerEl=body.parentElement.querySelector('.data-table-header h4');
    // just use from call
  }
  html+='</tr></thead><tbody>';
  pageRows.forEach(row=>{
    html+='<tr>';
    row.forEach(cell=>{
      if(typeof cell==='object'){html+=`<td class="${cell.cls||''}">${cell.v}</td>`}
      else{html+=`<td>${cell}</td>`}
    });
    html+='</tr>';
  });
  html+='</tbody></table>';
  html+=`<div class="pagination"><span>Mostrando ${start+1}-${end} de ${rows.length}</span><div class="page-btns">`;
  html+=`<button class="page-btn" onclick="changePage('${id}',-1)" ${st.page===0?'disabled':''}>◀ Anterior</button>`;
  const totalPages=Math.ceil(rows.length/st.pageSize);
  for(let i=0;i<Math.min(totalPages,7);i++){html+=`<button class="page-btn ${i===st.page?'active':''}" onclick="setPage('${id}',${i})">${i+1}</button>`}
  if(totalPages>7) html+=`<span style="color:var(--t3);padding:0 6px">...${totalPages}</span>`;
  html+=`<button class="page-btn" onclick="changePage('${id}',1)" ${st.page>=totalPages-1?'disabled':''}>Siguiente ▶</button></div></div>`;
  body.innerHTML=html;
}
function changePage(id,dir){tablePages[id].page+=dir;renderTablePage(id)}
function setPage(id,p){tablePages[id].page=p;renderTablePage(id)}
function searchTable(id,q){
  const st=tablePages[id];
  if(!q){st.filteredRows=null}else{
    const ql=q.toLowerCase();
    st.filteredRows=st.rows.filter(row=>row.some(cell=>{const v=typeof cell==='object'?cell.v:cell;return String(v).toLowerCase().includes(ql)}));
  }
  st.page=0;renderTablePage(id);
}

