empleadosData.forEach(r => {
  r.categoriaCosto = r.ocupacion === 'OPERADOR DE MAQUINARIA' ? 'Operadores' : r.ocupacion === 'MISCELANEO' ? 'Misceláneos' : 'Peones Agrícolas';
});

let laboresResumen = [];
const _labMap = {};
detalleLaboral.forEach(r => {
  if (!_labMap[r.codLabor]) _labMap[r.codLabor] = { codLabor: r.codLabor, labor: r.labor, unidad: 'Hora', cantidad: 0, total: 0 };
  _labMap[r.codLabor].cantidad += r.hOrd + r.hExt + r.hDob;
  _labMap[r.codLabor].total += r.total;
});
laboresResumen = Object.values(_labMap).filter(l => l.total > 0).sort((a,b) => b.total - a.total);
laboresResumen.forEach(r => {
  const cod = String(r.codLabor);
  if(cod.startsWith('101') && cod.length <= 8) r.categoria = 'Preparación Terreno';
  else if(cod.startsWith('102')) r.categoria = 'Siembra';
  else if(cod.startsWith('103')) r.categoria = 'Mantenimiento Cultivo';
  else if(cod.startsWith('100')) r.categoria = 'Mantenimiento Edificios';
  else if(cod.startsWith('110')) r.categoria = 'Taller';
  else if(cod.startsWith('120')) r.categoria = 'Jardines';
  else if(cod.startsWith('130')) r.categoria = 'Oficinas y Admin';
  else if(cod.startsWith('90')) r.categoria = 'Rondas y Linderos';
  else r.categoria = 'Otros';
});

const mesesData = {};
detalleLaboral.forEach(r => {
  if (!r.fecha) return;
  const m = r.fecha.substring(0,7);
  if (!mesesData[m]) mesesData[m] = { mes: m, horas: 0, costoLabores: 0, registros: 0, bruto: 0, seguro: 0, neto: 0 };
  mesesData[m].horas += r.hOrd + r.hExt + r.hDob;
  mesesData[m].costoLabores += r.total;
  mesesData[m].registros++;
});
nominaRaw.forEach(r => {
  if (!r.fecha1) return;
  const m = r.fecha1.substring(0,7);
  if (!mesesData[m]) mesesData[m] = { mes: m, horas: 0, costoLabores: 0, registros: 0, bruto: 0, seguro: 0, neto: 0 };
  mesesData[m].bruto += r.salTotal;
  mesesData[m].seguro += r.seguro;
  mesesData[m].neto += r.salNeto;
});
const mesesArray = Object.values(mesesData).sort((a,b) => a.mes > b.mes ? 1 : -1);

function renderKpiPlanillas(){
  const totalBruto = nominaRaw.reduce((s,r) => s + r.salTotal, 0);
  const totalNeto = nominaRaw.reduce((s,r) => s + r.salNeto, 0);
  const totalSeguro = nominaRaw.reduce((s,r) => s + r.seguro, 0);
  const totalCostoLabores = laboresResumen.reduce((s,r) => s + r.total, 0);
  const totalHoras = laboresResumen.reduce((s,r) => s + r.cantidad, 0);
  const costoPromHora = totalHoras > 0 ? totalCostoLabores / totalHoras : 0;
  const costoPromEmpleado = empleadosData.length > 0 ? totalBruto / empleadosData.length : 0;
  const categorias = [...new Set(laboresResumen.map(r => r.categoria))].length;
  const semanasConDatos = [...new Set(nominaRaw.map(r => r.semana))].length;
  const ocupaciones = {};
  empleadosData.forEach(r => { ocupaciones[r.categoriaCosto] = (ocupaciones[r.categoriaCosto] || 0) + 1; });
  const topOcup = Object.entries(ocupaciones).sort((a,b) => b[1] - a[1]);
  
  document.getElementById('kpiPlanillas').innerHTML = [
    kpiCard('💰','Planilla Bruta Total',fmtMoney(totalBruto), planillasPeriodo,'#6366f1'),
    kpiCard('💵','Salario Neto Total',fmtMoney(totalNeto), 'después de deducciones','#10b981'),
    kpiCard('🏥','Cargas Sociales (CCSS)',fmtMoney(totalSeguro), ((totalBruto>0?totalSeguro/totalBruto*100:0).toFixed(1))+'% del bruto','#ef4444'),
    kpiCard('👥','Total Empleados', empleadosData.length, topOcup.map(x=>x[0]+': '+x[1]).join(' | '),'#3b82f6'),
    kpiCard('📅','Meses con Datos', mesesArray.length, semanasConDatos+' semanas procesadas','#f59e0b'),
    kpiCard('💵','Costo Prom/Empleado',fmtMoney(costoPromEmpleado),'salario bruto acumulado promedio','#8b5cf6'),
    kpiCard('🔧','Total Horas Laboradas',fmtInt(totalHoras), laboresResumen.length+' labores | '+categorias+' categorías','#06b6d4'),
    kpiCard('📊','Costo Promedio/Hora','₡'+costoPromHora.toFixed(2),'por hora de labor','#ec4899'),
    kpiCard('🏦','Costo Total por Labores',fmtMoney(totalCostoLabores),'distribuido en '+laboresResumen.length+' actividades','#14b8a6'),
  ].join('');
}

function renderChartsPlanillas(){
  const el = document.getElementById('chartsPlanillas'); el.innerHTML = '';
  const months = mesesArray.map(m => { const [y,mo] = m.mes.split('-'); const names = ['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic']; return names[+mo]+' '+y.substring(2); });
  
  makeChart('chartsPlanillas','chPlanEvoMensual','📅 Evolución Mensual de Planilla','Nómina bruta y costo labores por mes','bar',
    months, [{label:'Nómina Bruta',data:mesesArray.map(m=>m.bruto||0),backgroundColor:'rgba(99,102,241,.7)',borderRadius:4},{label:'Costo Labores',data:mesesArray.map(m=>m.costoLabores),backgroundColor:'rgba(16,185,129,.7)',borderRadius:4}], {moneyTooltip:true,full:true});
  
  const salByOcup = {};
  nominaRaw.forEach(r => { const emp = empleadosData.find(e => e.codigo === r.codigo); const cat = emp ? emp.categoriaCosto : 'Otros'; salByOcup[cat] = (salByOcup[cat] || 0) + r.salTotal; });
  makeChart('chartsPlanillas','chPlanOcup','💼 Distribución Salarial por Ocupación','Salario bruto acumulado por categoría','doughnut',
    Object.keys(salByOcup), [{data:Object.values(salByOcup),backgroundColor:['#6366f1','#10b981','#f59e0b','#ef4444']}], {moneyTooltipPie:true});
  
  const empTotals = {};
  nominaRaw.forEach(r => { empTotals[r.nombre] = (empTotals[r.nombre] || 0) + r.salTotal; });
  const sorted = Object.entries(empTotals).sort((a,b) => b[1] - a[1]);
  makeChart('chartsPlanillas','chPlanEmp','👥 Salario Bruto Acumulado por Empleado','Total acumulado en el período','bar',
    sorted.map(([n]) => n.split(' ').slice(0,2).join(' ')), [{label:'Salario Bruto',data:sorted.map(([,v]) => v),backgroundColor:COLORS.slice(0,sorted.length).concat(COLORS),borderRadius:4}], {indexAxis:true,moneyTooltip:true,noLegend:true,full:true,tall:true});
  
  const topLab = laboresResumen.slice(0,10);
  makeChart('chartsPlanillas','chPlanTopLab','🔧 Top 10 Labores por Costo Acumulado','Las actividades con mayor inversión en mano de obra','bar',
    topLab.map(r => r.labor.length > 30 ? r.labor.substring(0,30)+'…' : r.labor), [{label:'Costo',data:topLab.map(r=>r.total),backgroundColor:COLORS,borderRadius:6}], {indexAxis:true,moneyTooltip:true,noLegend:true,full:true,tall:true});
  
  const catMap = {};
  laboresResumen.forEach(r => { catMap[r.categoria] = (catMap[r.categoria] || 0) + r.total; });
  const catLabels = Object.keys(catMap).sort((a,b) => catMap[b] - catMap[a]);
  makeChart('chartsPlanillas','chPlanCat','🏗️ Inversión por Categoría de Labor','Distribución del costo de mano de obra','doughnut',
    catLabels, [{data:catLabels.map(c=>catMap[c]),backgroundColor:COLORS.slice(0,catLabels.length)}], {moneyTooltipPie:true});
  
  makeChart('chartsPlanillas','chPlanHorasMes','⏱️ Horas Laboradas por Mes','Tendencia de horas trabajadas','line',
    months, [{label:'Horas',data:mesesArray.map(m=>m.horas),borderColor:'#8b5cf6',backgroundColor:'rgba(139,92,246,.1)',fill:true,tension:.4,pointRadius:3}], {noLegend:true,full:true});
  
  makeChart('chartsPlanillas','chPlanCCSS','🏥 Composición: Neto vs CCSS por Mes','Desglose del costo total','bar',
    months, [{label:'Salario Neto',data:mesesArray.map(m=>m.neto||0),backgroundColor:'rgba(16,185,129,.7)',borderRadius:2},{label:'CCSS',data:mesesArray.map(m=>m.seguro||0),backgroundColor:'rgba(239,68,68,.7)',borderRadius:2}], {stacked:true,moneyTooltip:true,full:true});
}

function renderTablePlanillas(){
  const container = document.getElementById('tablePlanillas'); container.innerHTML = '';
  const mesRows = mesesArray.map(m => { const [y,mo] = m.mes.split('-'); const names = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']; return [names[+mo]+' '+y, {v:fmtInt(m.horas),cls:'num'}, {v:fmtInt(m.registros),cls:'num'}, {v:fmtMoney(m.bruto||0),cls:'num money'}, {v:fmtMoney(m.seguro||0),cls:'num money'}, {v:fmtMoney(m.neto||0),cls:'num money'}, {v:fmtMoney(m.costoLabores),cls:'num money'}, {v:'₡'+(m.horas>0?(m.costoLabores/m.horas).toFixed(2):'0'),cls:'num money'}]; });
  buildTable(container,'tblPlanMensual','📅 Resumen Mensual de Planillas', ['Mes','Horas','Registros','Nómina Bruta','CCSS','Nómina Neta','Costo Labores','Costo/Hora'], mesRows, mesRows.length, 25);
  
  const empAcum = {};
  nominaRaw.forEach(r => { if (!empAcum[r.codigo]) { const emp = empleadosData.find(e => e.codigo === r.codigo); empAcum[r.codigo] = { nombre: r.nombre, ocupacion: emp ? emp.ocupacion : 'N/A', bruto: 0, seguro: 0, neto: 0, semanas: 0 }; } empAcum[r.codigo].bruto += r.salTotal; empAcum[r.codigo].seguro += r.seguro; empAcum[r.codigo].neto += r.salNeto; empAcum[r.codigo].semanas++; });
  const empRows = Object.values(empAcum).sort((a,b) => b.bruto - a.bruto).map(e => [e.nombre, e.ocupacion, {v:e.semanas,cls:'num'}, {v:fmtMoney(e.bruto),cls:'num money'}, {v:fmtMoney(e.seguro),cls:'num money'}, {v:fmtMoney(e.neto),cls:'num money'}, {v:fmtMoney(e.semanas>0?e.bruto/e.semanas:0),cls:'num money'}]);
  buildTable(container,'tblPlanEmpleados','👥 Acumulado por Empleado ('+planillasPeriodo+')', ['Nombre','Ocupación','Semanas','Sal. Bruto Acum.','CCSS Acum.','Sal. Neto Acum.','Prom. Semanal'], empRows, empRows.length, 25);
  
  const labRows = laboresResumen.map(r => [r.codLabor, r.labor, r.categoria, {v:fmtInt(r.cantidad),cls:'num'}, {v:fmtMoney(r.total),cls:'num money'}, {v:'₡'+(r.cantidad>0?(r.total/r.cantidad).toFixed(2):'0'),cls:'num money'}]);
  buildTable(container,'tblPlanLabores','🔧 Resumen por Labores', ['Código','Labor','Categoría','Horas','Costo Total','Costo/Hora'], labRows, labRows.length, 50);
}


function renderAll(){
  if(currentTab==='siembra'){renderKpiSiembra();renderChartsSiembra();renderTableSiembra()}
  else if(currentTab==='aplicaciones'){renderKpiAplic();renderChartsAplic();renderTableAplic()}
  else if(currentTab==='planillas'){renderKpiPlanillas();renderChartsPlanillas();renderTablePlanillas()}
  else{renderKpiConsolidado();renderChartsConsolidado();renderTableConsolidado()}
}

